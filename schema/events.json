{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "radiopassive/schema/events.json",
  "title": "Radiopassive event row",
  "description": "One row of data/events.csv (SCHEMA.md §4.4). Stage, country and source membership, and the match between this row and its master transfer rows, are checked by pipeline/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "name", "date_start", "country", "stream", "stage", "event_type", "is_accident",
               "from_tier", "to_tier", "inclusion", "military", "source_ids"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^E[0-9]{3}$"},
    "name": {"type": "string", "minLength": 3},
    "date_start": {"type": "string", "pattern": "^(19[5-9][0-9]|20[0-2][0-9])-[01][0-9]-[0-3][0-9]$"},
    "date_end": {"type": ["string", "null"], "pattern": "^(19[5-9][0-9]|20[0-2][0-9])-[01][0-9]-[0-3][0-9]$"},
    "country": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "location": {"type": ["string", "null"]},
    "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "stream": {"enum": ["nuclear", "coal", "oil_gas", "wind_solar", "other"]},
    "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "event_type": {"enum": ["accident", "impoundment_failure", "spill", "other"]},
    "is_accident": {"type": "boolean"},
    "from_tier": {"enum": ["sealed_in_core", "sealed_fuel_cycle", "sealed_damaged_core", "impounded",
                           "reisolated", "dispersed", "liberated"]},
    "to_tier": {"enum": ["sealed_in_core", "sealed_fuel_cycle", "sealed_damaged_core", "impounded",
                         "reisolated", "dispersed", "liberated"]},
    "mass_t": {"type": ["number", "null"], "minimum": 0},
    "activity_central_bq": {"type": ["number", "null"], "minimum": 0},
    "inclusion": {"enum": ["activity", "mass"]},
    "military": {"const": false},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
                   "items": {"type": "string", "pattern": "^S[0-9]{4}$"}},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "accident"}}},
     "then": {"properties": {"is_accident": {"const": true}}},
     "else": {"properties": {"is_accident": {"const": false}}}},
    {"if": {"properties": {"inclusion": {"const": "activity"}}},
     "then": {"required": ["activity_central_bq"],
              "properties": {"activity_central_bq": {"type": "number", "minimum": 1e12}}}},
    {"if": {"properties": {"inclusion": {"const": "mass"}}},
     "then": {"required": ["mass_t"], "properties": {"mass_t": {"type": "number", "minimum": 1e5}}}},
    {"not": {"properties": {"from_tier": {"const": "liberated"}, "to_tier": {"const": "liberated"}}}}
  ]
}
