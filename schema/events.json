{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "radiopassive/schema/events.json",
  "title": "Radiopassive event row (v2)",
  "description": "One row of data/events.csv (SCHEMA.md §4.4). Inclusion thresholds and destination rules (E03), real-date and bound checks (E01) and membership (E02) are checked by pipeline/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "name",
    "date_start",
    "date_end",
    "country",
    "location",
    "lat",
    "lon",
    "stream",
    "stage",
    "event_type",
    "is_accident",
    "from_tier",
    "to_tiers",
    "mass_t",
    "activity_low_bq",
    "activity_central_bq",
    "activity_high_bq",
    "inclusion",
    "military",
    "source_ids",
    "notes"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^E[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "date_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "date_end": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "stream": {
      "enum": [
        "nuclear",
        "coal",
        "oil_gas",
        "wind_solar",
        "other"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "accident",
        "impoundment_failure",
        "spill",
        "other"
      ]
    },
    "is_accident": {
      "type": "boolean"
    },
    "from_tier": {
      "enum": [
        "sealed_in_core",
        "sealed_fuel_cycle",
        "sealed_damaged_core",
        "impounded",
        "reisolated",
        "dispersed",
        "liberated"
      ]
    },
    "to_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sealed_in_core",
          "sealed_fuel_cycle",
          "sealed_damaged_core",
          "impounded",
          "reisolated",
          "dispersed",
          "liberated"
        ]
      }
    },
    "mass_t": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "activity_low_bq": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "activity_central_bq": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "activity_high_bq": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "inclusion": {
      "enum": [
        "activity",
        "mass"
      ]
    },
    "military": {
      "const": false
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "accident"
          }
        }
      },
      "then": {
        "properties": {
          "is_accident": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "is_accident": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inclusion": {
            "const": "activity"
          }
        }
      },
      "then": {
        "properties": {
          "activity_low_bq": {
            "type": "number"
          },
          "activity_central_bq": {
            "type": "number"
          },
          "activity_high_bq": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inclusion": {
            "const": "mass"
          }
        }
      },
      "then": {
        "properties": {
          "mass_t": {
            "type": "number"
          }
        }
      }
    }
  ]
}
