{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "radiopassive/schema/residue_seepage_by_group.json",
  "title": "Radiopassive per-group residue seepage row",
  "description": "One row of data/reference/residue_seepage_by_group.csv (SCHEMA.md §4.12). All three seepage values, basis and source_ids are required; ordering (T03), duplicate keys (T02) and references (T04) are checked by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "residue_type",
    "group",
    "seepage_low",
    "seepage_central",
    "seepage_high",
    "basis",
    "source_ids",
    "notes"
  ],
  "properties": {
    "residue_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "seepage_low": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seepage_central": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seepage_high": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "basis": {
      "enum": [
        "measured",
        "compiled",
        "modelled",
        "interpolated",
        "extrapolated"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
