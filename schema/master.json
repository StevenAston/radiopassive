{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "radiopassive/schema/master.json",
  "title": "Radiopassive master row (v2)",
  "description": "One row of data/streams/*.csv or build/master.csv, after type coercion (SCHEMA.md §3). Covers types, the fixed enums and conditional rules. Membership of substream, stage, product, residue_type, country, group, source, factor and event IDs is checked by pipeline/validate.py (V-codes), not here, so each fault raises exactly one code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "year",
    "stream",
    "substream",
    "stage",
    "product",
    "residue_type",
    "country",
    "group",
    "tier",
    "quantity",
    "unit",
    "value_low",
    "value_central",
    "value_high",
    "below_detection",
    "basis",
    "source_ids",
    "factor_ids",
    "allocation_variant",
    "allocation_rule",
    "embedded_fuel",
    "technology",
    "route",
    "event_id",
    "notes"
  ],
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 1950,
      "maximum": 2025
    },
    "stream": {
      "enum": [
        "nuclear",
        "coal",
        "oil_gas",
        "wind_solar",
        "other"
      ]
    },
    "substream": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "residue_type": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "sealed_in_core",
        "sealed_fuel_cycle",
        "sealed_damaged_core",
        "impounded",
        "reisolated",
        "dispersed",
        "liberated",
        "memo_earth_moved"
      ]
    },
    "quantity": {
      "enum": [
        "flow",
        "transfer_out",
        "transfer_in",
        "standing_inventory",
        "opening_stock"
      ]
    },
    "unit": {
      "enum": [
        "Bq/a",
        "Bq"
      ]
    },
    "value_low": {
      "type": "number",
      "minimum": 0
    },
    "value_central": {
      "type": "number",
      "minimum": 0
    },
    "value_high": {
      "type": "number",
      "minimum": 0
    },
    "below_detection": {
      "type": "boolean"
    },
    "basis": {
      "enum": [
        "measured",
        "compiled",
        "modelled",
        "interpolated",
        "extrapolated"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "factor_ids": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allocation_variant": {
      "enum": [
        "default",
        "bound_main",
        "bound_radio"
      ]
    },
    "allocation_rule": {
      "type": "string",
      "pattern": "^(none|alloc:value|alloc:mass|alloc:main|alloc:radio|elec_share|civil:doc|civil:pre1965|civil:ratio|civil:throughput)(;(none|alloc:value|alloc:mass|alloc:main|alloc:radio|elec_share|civil:doc|civil:pre1965|civil:ratio|civil:throughput))*$"
    },
    "embedded_fuel": {
      "type": "boolean"
    },
    "technology": {
      "enum": [
        null,
        "coal_power",
        "gas_power",
        "oil_power",
        "nuclear",
        "wind",
        "solar",
        "geothermal",
        "biomass",
        "hydro"
      ]
    },
    "route": {
      "enum": [
        null,
        "air_stack",
        "air_ventilation",
        "air_process_vent",
        "air_vented_gas",
        "air_delivered_gas",
        "air_dust",
        "water_liquid_effluent",
        "water_mine_drainage",
        "water_produced_discharge",
        "water_spill",
        "sea_disposal_package",
        "air_accident_release",
        "water_accident_release"
      ]
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quantity": {
            "const": "flow"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "Bq/a"
          }
        }
      },
      "else": {
        "properties": {
          "unit": {
            "const": "Bq"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quantity": {
            "const": "standing_inventory"
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "sealed_in_core"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "sealed_in_core"
          }
        }
      },
      "then": {
        "properties": {
          "quantity": {
            "enum": [
              "standing_inventory",
              "transfer_out"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quantity": {
            "const": "opening_stock"
          }
        }
      },
      "then": {
        "properties": {
          "year": {
            "const": 1950
          },
          "tier": {
            "not": {
              "enum": [
                "sealed_in_core",
                "memo_earth_moved"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "memo_earth_moved"
          }
        }
      },
      "then": {
        "properties": {
          "quantity": {
            "const": "flow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "below_detection": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "value_low": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "embedded_fuel": {
            "const": true
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "stream": {
                "const": "wind_solar"
              }
            }
          },
          {
            "properties": {
              "stage": {
                "pattern": "^construction"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "impounded",
              "reisolated",
              "dispersed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "residue_type": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "residue_type": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "liberated"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "route": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "const": "modelled"
          }
        }
      },
      "then": {
        "properties": {
          "factor_ids": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allocation_variant": {
            "const": "bound_main"
          }
        }
      },
      "then": {
        "properties": {
          "allocation_rule": {
            "pattern": "(^|;)alloc:main(;|$)"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allocation_variant": {
            "const": "bound_radio"
          }
        }
      },
      "then": {
        "properties": {
          "allocation_rule": {
            "pattern": "(^|;)alloc:radio(;|$)"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allocation_rule": {
            "pattern": "(^|;)civil:pre1965(;|$)"
          }
        }
      },
      "then": {
        "properties": {
          "year": {
            "maximum": 1964
          },
          "value_high": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allocation_rule": {
            "pattern": "(^|;)civil:ratio(;|$)"
          }
        }
      },
      "then": {
        "properties": {
          "year": {
            "minimum": 1965
          }
        }
      }
    }
  ]
}
